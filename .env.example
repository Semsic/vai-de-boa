# Copie para .env para executar a API localmente. Não publique suas credenciais.
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
JWT_SECRET=troque-por-uma-chave-local-com-mais-de-32-caracteres
RATE_LIMIT_SECRET=troque-por-outra-chave-local-com-mais-de-32-caracteres
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_substitua_no_servidor

# No Render e na Netlify, configure o mesmo segredo aleatório exclusivamente no servidor.
PROXY_SECRET=troque-por-uma-terceira-chave-com-mais-de-32-caracteres
# Somente na Netlify (escopo Functions); exemplo sem credencial.
RENDER_API_URL=https://seu-servico.onrender.com
